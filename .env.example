# Optional external FastAPI URL; leave empty for same-origin /api.
VITE_API_URL=
# Backend local SQLite path
ASTROCARE_DB=astrocare.db
# Optional browser origin when running a separately hosted frontend
ASTROCARE_ORIGIN=http://localhost:5173
# Server-only optional RAG settings. Never use VITE_ prefixes for secrets.
# Generation remains off until a key AND model are configured securely.
ASTROCARE_RAG_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=
